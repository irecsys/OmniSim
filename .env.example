# Copy this file to .env and fill in the keys for the provider(s) you use.
# Variable names below are exactly what the code reads — do not rename them.

# ── OpenAI (chat + embeddings) ───────────────────────────────────────────────
OPENAI_KEY=sk-...

# ── Azure OpenAI (chat + embeddings — same key for both) ─────────────────────
# Endpoints / API versions are set in configs/system/system.yaml, not here.
AZURE_KEY=...

# ── ThetaEdgeCloud (open-source models, e.g. Llama) ──────────────────────────
THETA_KEY=...

# ── Elasticsearch (only needed if xpack.security.enabled=true) ───────────────
ES_USER=elastic
ES_PWD=...
