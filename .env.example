# Copy this file to .env and fill in the keys for the provider(s) you use.
# Variable names below are exactly what the code reads — do not rename them.

# ── OpenAI (chat + embeddings) ───────────────────────────────────────────────
OPENAI_KEY=sk-...

# ── Azure OpenAI / Azure AI Foundry (openai_provider azure or azure_foundry, embeddings_provider azure;
#    same key for chat and embeddings) ─────────────────────
# Endpoints / API versions are set in configs/system/system.yaml, not here.
AZURE_KEY=...

# ── ThetaEdgeCloud (open-source models, e.g. Llama; chat only, no embeddings) ──────────────────────────
THETA_KEY=...

# ── Evaluation tools only (utils/judge.py, utils/compare_judge.py, scripts/run_judge_all.py) ──
# The judge builds its own clients from environment variables (not from system.yaml):
#   --provider openai          OPENAI_KEY; optional OPENAI_API_BASE (base URL of another endpoint)
#   --provider azure           OPENAI_KEY (note: the judge's azure branch reads OPENAI_KEY, not AZURE_KEY
#                              as the simulator does), AZURE_OPENAI_ENDPOINT, AZURE_OPENAI_API_VERSION
#                              (default 2024-02-01)
#   --provider azure_foundry   AZURE_KEY, AZURE_FOUNDRY_ENDPOINT (required; .../openai/v1). scripts/run_judge_all.py
#                              uses it for its "gpt" judge.
#   --provider thetaedgecloud  THETA_KEY
#   --provider deepseek        DEEPSEEK_KEY
#   --provider gemini          GEMINI_KEY
# Without --model / --provider, utils/judge.py falls back to JUDGE_MODEL or CHAT_MODEL (default gpt-4o)
# and OPENAI_PROVIDER (default openai).
